{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2015",
    "rootDir": "src/main/resources/static/src/typescript",
    "outDir": "src/main/resources/static/build/js",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["src/main/resources/static/src/typescript/**/*.ts"],
  "exclude": ["node_modules"]
}
